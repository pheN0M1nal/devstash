# ---------------------------------------------------------------------------
# Neon PostgreSQL
# ---------------------------------------------------------------------------
# Neon gives you two connection strings for the same branch. Both are needed.
#
#   DATABASE_URL          pooled   — hostname contains "-pooler". Used by the
#                                    app at runtime via the Neon driver adapter.
#   DATABASE_URL_UNPOOLED direct   — no "-pooler". Used by the Prisma CLI for
#                                    migrations; migrate cannot run over a pooler.
#
# Point these at your DEVELOPMENT branch. Production uses its own branch and is
# deployed with `prisma migrate deploy`, never `migrate dev`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/devstash?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/devstash?sslmode=require"

# `prisma migrate dev` needs a throwaway shadow database to detect drift.
# Create a second database on the same Neon branch (e.g. named "shadow") and
# use its DIRECT (unpooled) connection string here.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/shadow?sslmode=require"
